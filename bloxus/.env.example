# Sao chép file này thành `.env.local` rồi điền 2 giá trị từ Supabase Dashboard
# (Settings -> API). Xem SETUP.md để có hướng dẫn từng bước bằng hình.
#
# LƯU Ý: anon key là khóa CÔNG KHAI (an toàn để nhúng vào web) — dữ liệu được
# bảo vệ bằng Row Level Security phía server, không phải bằng việc giấu key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (captcha) - Site Key lay tu dash.cloudflare.com > Turnstile
VITE_TURNSTILE_SITE_KEY=
