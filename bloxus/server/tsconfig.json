{
  // Kiểm tra kiểu cho code chạy trên Cloudflare Pages Functions (server/ + functions/).
  // Tách khỏi tsconfig gốc vì môi trường khác (không có React, không có @/ alias).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["./*.ts", "../functions/**/*.ts"]
}
